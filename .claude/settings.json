{
  "agent": "tutor",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git init:*)",
      "Bash(date:*)",
      "Bash(python3 scripts/tutor.py:*)",
      "Bash(python3 ./scripts/tutor.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-closed-notes.sh\""
          }
        ]
      }
    ]
  }
}
